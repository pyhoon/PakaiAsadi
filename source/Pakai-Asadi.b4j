AppType=StandardJava
Build1=Default,b4j.pakai,hu2_acceptall
Group=App
Library1=endsmeet
Library2=jcore
Library3=minihtml
Library4=miniormutils
Module1=AsadiHandler
Module2=AsadiState
Module3=DemoHomeHandler
Module4=PakaiAsadi
NumberOfFiles=0
NumberOfLibraries=4
NumberOfModules=4
Version=10.7
@EndOfDesignText@
#Region Project Attributes
' Pakai Asadi - embeddable SQLite workspace for B4J.
' The library build excludes this main module, so the attributes below describe the
' packaged .b4xlib; the module itself stays a runnable demo host.
#CommandLineArgs:
#MergeLibraries: True
#LibraryName: PakaiAsadi
#LibraryVersion: 1.01
#LibraryAuthor: Aeric Poon
#AdditionalJar: sqlite-jdbc
#End Region
#Region  Macros
#Macro: Title, Update Manifest, ide://run?File=%ADDITIONAL%\..\B4X\manifest-writer.jar&Args=%PROJECT%&Args=%PROJECT%&Args=Author&Args=Aeric+Poon&Args=Version&Args=1.01&Args=B4J.DependsOn&Args=EndsMeet,+MiniHTML,+MiniORMUtils,+sqlite-jdbc&Args=Supported+Platforms&Args=B4J
#Macro: Title, Create B4xLib, ide://run?File=%JAVABIN%\jar.exe&WorkingDirectory=..\&Args=-cMf&Args=..\release\PakaiAsadi.b4xlib&Args=*Asadi*.bas&Args=manifest.txt&Args=..\LICENSE
#Macro: Title, Release folder, ide://run?File=%WINDIR%\SysWOW64\explorer.exe&Args=%PROJECT%\..\release
#Macro: Title, Copy to AddLibs, ide://run?File=%COMSPEC%&Args=/c&Args=copy&Args=%PROJECT%\..\release\*.b4xlib&Args=%ADDITIONAL%\..\B4X
#Macro: Title, ModelGenerator, ide://run?File=%ADDITIONAL%\modgen.jar&Args=%STATE1%&codesync=True
#End Region
Sub Process_Globals
	Public App As EndsMeet
	Private Asadi As PakaiAsadi
	Private DemoDirectory As String
End Sub

' <link>Open in browser|http://127.0.0.1:8080</link> | <link>Donate|https://paypal.me/aeric80/</link>
Sub AppStart (Args() As String)
	App.Initialize
	App.Port = 8080
	DemoDirectory = File.Combine(File.DirApp, "data")
	File.MakeDir(File.DirApp, "data")
	CreateDemoDatabase

	App.Get("", "DemoHomeHandler")
	Asadi.Initialize(App, DemoDirectory, "AuthorizeAsadi")
	Asadi.BasePath = "/asadi"
	If Asadi.AddDatabase("demo", File.Combine(DemoDirectory, "demo.db")) = False Then
		Log("Demo database registration failed")
		Return
	End If
	If Asadi.Start = False Then
		Log("Asadi startup failed; host server will not start")
		Return
	End If
	App.Start
	Log(App.StartupMessage)
	Log("Demo home: " & App.ServerUrl & "/")
	Log("Asadi workspace: " & App.ServerUrl & "/asadi")
	StartMessageLoop
End Sub

' Demo-only gate: accept requests originating from the same machine. Replace with the host's real admin-role check.
Public Sub AuthorizeAsadi (req As ServletRequest) As Boolean
	Dim Address As String = req.RemoteAddress
	Return Address = "127.0.0.1" Or Address = "::1" Or Address = "0:0:0:0:0:0:0:1"
End Sub

Private Sub CreateDemoDatabase
	Dim Path As String = File.Combine(DemoDirectory, "demo.db")
	Dim Db As SQL
	Db.Initialize("org.sqlite.JDBC", "jdbc:sqlite:" & Path)
	Db.ExecNonQuery("CREATE TABLE IF NOT EXISTS notes (id INTEGER PRIMARY KEY, title TEXT NOT NULL, body TEXT)")
	Dim Count As Int = Db.ExecQuerySingleResult("SELECT COUNT(*) FROM notes")
	If Count = 0 Then Db.ExecNonQuery2("INSERT INTO notes(title, body) VALUES(?, ?)", Array As String("Welcome", "This database is registered by trusted demo-host code."))
	Db.Close
End Sub
